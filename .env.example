# ==============================================================================
# Environment Configuration - India Safe Water Program Operations Management
# ==============================================================================
# NOTE: This file contains placeholder values for setup.
# Copy this file to .env and configure with your local environment values.
# NEVER commit the actual .env file or real secrets to version control.
# ==============================================================================

# Application Port
PORT=3000

# Environment Mode (development | production | test)
NODE_ENV=development

# JWT Authentication Secret (Use a strong random string in production)
JWT_SECRET=your_jwt_secret_key_change_in_production_min_32_chars

# JWT Token Expiration duration (e.g., 8h, 24h, 7d)
JWT_EXPIRES_IN=8h

# PostgreSQL Database Configuration
# Option A: Full Connection String (Takes precedence if provided)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/evidence_action

# Option B: Individual PostgreSQL Connection Parameters (Used if DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password
PGDATABASE=evidence_action
