{
  "name": "evidence-action-operations-platform",
  "version": "1.0.0",
  "description": "Field visit planning and approval service for Evidence Action India Safe Water Program",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:migrate": "node src/db/migrate.js --schema",
    "db:seed": "node src/db/migrate.js --seed",
    "db:setup": "node src/db/migrate.js --setup",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --forceExit"
  },
  "keywords": [
    "evidence-action",
    "operations-management",
    "field-visits",
    "safe-water",
    "express",
    "postgresql"
  ],
  "author": "Software Development Intern Candidate",
  "license": "ISC",
  "dependencies": {
    "@electric-sql/pglite": "^0.2.14",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
